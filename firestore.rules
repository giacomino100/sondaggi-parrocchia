rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /surveys/{surveyId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /responses/{responseId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null;
      }
    }

    match /registrations/{registrationId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      // I genitori possono solo inviare l'iscrizione; i dati li vede solo chi è loggato
      match /entries/{entryId} {
        allow create: if get(/databases/$(database)/documents/registrations/$(registrationId)).data.status == 'open'
          && request.resource.data.consensoPrivacy == true
          && request.resource.data.consensoFoto is bool;
        allow read, update, delete: if request.auth != null;
      }
    }
  }
}
